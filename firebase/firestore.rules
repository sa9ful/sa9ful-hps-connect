rules_version = '2';

// HPS Connect: প্রাথমিক সিকিউরিটি রুলস।
// রোল আইডি lib/models/user_role.dart-এর সাথে মিলিয়ে রাখুন।
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- সহায়ক ফাংশন ----------
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function role() {
      return me().role;
    }
    function hasRole(roles) {
      return isActive() && role() in roles;
    }
    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }
    // নোটিশ/জরুরি সতর্কবার্তা পাঠাতে পারে
    function isLeader() {
      return hasRole(['principal', 'super_admin', 'junior_incharge',
                      'high_incharge', 'residential_incharge']);
    }
    function validRole(r) {
      return r in ['principal', 'junior_incharge', 'high_incharge',
                   'residential_incharge', 'super_admin', 'teacher'];
    }

    // ---------- রোল তালিকা ----------
    match /roles/{roleId} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // ---------- ব্যবহারকারী ----------
    // users/{uid}: name, email, role, section, active, fcmTokens, lastSeenAt
    match /users/{uid} {
      // নিজের প্রোফাইল সবসময় পড়া যায় (না হলে "অ্যাকাউন্ট চালু হয়নি" দেখানো যায় না);
      // সক্রিয় স্টাফরা স্টাফ ডিরেক্টরি দেখতে পারে।
      allow read: if (signedIn() && request.auth.uid == uid) || isActive();

      // শুধু সুপার অ্যাডমিন অ্যাকাউন্ট তৈরি/মুছে ফেলতে বা রোল বদলাতে পারে।
      allow create: if isSuperAdmin() && validRole(request.resource.data.role);
      allow delete: if isSuperAdmin();
      allow update: if (isSuperAdmin() && validRole(request.resource.data.role))
        // নিজে শুধু এই ফিল্ডগুলো বদলাতে পারে, রোল বা active নয়।
        || (isActive() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'photoUrl', 'fcmTokens', 'lastSeenAt']));
    }

    // ---------- নোটিশ ও জরুরি সতর্কবার্তা ----------
    match /notices/{noticeId} {
      allow read: if isActive();
      allow create: if isLeader() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSuperAdmin()
        || (isLeader() && resource.data.authorId == request.auth.uid);

      // পড়া/স্বীকৃতি ট্র্যাকিং: notices/{id}/reads/{uid}
      match /reads/{readerId} {
        // Viewed: 112/150 গণনার জন্য সক্রিয় সবাই পড়তে পারে
        allow read: if isActive();
        allow create, update: if isActive() && request.auth.uid == readerId;
      }
    }

    // ---------- ছুটির আবেদন ----------
    match /leaveRequests/{id} {
      allow read: if isActive()
        && (resource.data.userId == request.auth.uid || isLeader());
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      // অনুমোদন/বাতিল শুধু নেতৃত্বের রোল
      allow update: if isLeader();
    }

    // collection group query: আমি কোন নোটিশগুলো দেখেছি (Unread Notices গণনা)
    match /{path=**}/reads/{readerId} {
      allow read: if isActive() && resource.data.uid == request.auth.uid;
    }

    // ---------- মিটিং ----------
    // meetings/{id}: title, startAt, location, createdBy, joined[]
    match /meetings/{id} {
      allow read: if isActive();
      allow create: if isLeader() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSuperAdmin() || (isLeader() && resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin()
        || (isLeader() && resource.data.createdBy == request.auth.uid)
        // যে কেউ শুধু নিজেকে joined তালিকায় যোগ করতে পারে
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
            && request.resource.data.joined.toSet().difference(resource.data.joined.toSet())
                 .hasOnly([request.auth.uid]));
    }

    // ---------- টাস্ক ----------
    // tasks/{id}: title, dueAt, assigneeId, assignedById, done
    match /tasks/{id} {
      allow read: if isActive()
        && (resource.data.assigneeId == request.auth.uid
            || resource.data.assignedById == request.auth.uid
            || isLeader());
      // যে কেউ নিজের জন্য টাস্ক বানাতে পারে; অন্যকে দিতে পারে শুধু নেতৃত্বের রোল
      allow create: if isActive()
        && request.resource.data.assignedById == request.auth.uid
        && (request.resource.data.assigneeId == request.auth.uid || isLeader());
      allow update: if isActive()
        && (resource.data.assignedById == request.auth.uid
            || (resource.data.assigneeId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])));
      allow delete: if isActive() && resource.data.assignedById == request.auth.uid;
    }

    // ---------- চ্যাট ----------
    // chats/{id}: name, type ('personal'|'group'), members[], lastMessage, lastAt, unread{uid: n}
    function isMember(chatId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /chats/{chatId} {
      allow read: if isActive() && request.auth.uid in resource.data.members;
      allow create: if isActive() && request.auth.uid in request.resource.data.members;
      allow update: if isActive() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isActive() && isMember(chatId);
        allow create: if isActive() && isMember(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // বাকি সব কিছু ডিফল্টভাবে বন্ধ। নতুন ফিচার যোগ করার সময় এখানে রুল যোগ করুন।
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
